const allJapaneseMeanings = wordsData.map(w => w.japanese);
let currentQuizWords = [];
let currentIndex = 0;
let score = 0;
let isAnswered = false;
document.getElementById('max-info').innerText = ※このファイルには全 ${wordsData.length} 単語が収録されています。;
function startQuiz() {
const selectedLevel = document.getElementById('level-select').value;
let requestedCount = parseInt(document.getElementById('question-count').value);
if (selectedLevel === 'all') {
currentQuizWords = [...wordsData];
} else {
currentQuizWords = wordsData.filter(w => w.level === selectedLevel);
}
if (currentQuizWords.length === 0) {
alert("該当するレベルの単語がありません。");
return;
}
currentQuizWords.sort(() => Math.random() - 0.5);
if (isNaN(requestedCount) || requestedCount <= 0) {
requestedCount = 10;
}
if (requestedCount > currentQuizWords.length) {
requestedCount = currentQuizWords.length;
}
currentQuizWords = currentQuizWords.slice(0, requestedCount);
currentIndex = 0;
score = 0;
showScreen('quiz-screen');
showQuestion();
}
function showQuestion() {
isAnswered = false;
document.getElementById('next-btn').style.display = 'none';
document.getElementById('feedback').innerText = '';
document.getElementById('feedback').className = 'feedback-message';
const currentWord = currentQuizWords[currentIndex];
document.getElementById('progress-text').innerText = 第 ${currentIndex + 1} 問 / ${currentQuizWords.length} 問 [${currentWord.level}];
document.getElementById('word-text').innerText = currentWord.english;
let choices = [currentWord.japanese];
const wrongMeanings = allJapaneseMeanings.filter(m => m !== currentWord.japanese);
wrongMeanings.sort(() => Math.random() - 0.5);
for (let i = 0; i < 3; i++) {
if (wrongMeanings[i]) choices.push(wrongMeanings[i]);
}
choices.sort(() => Math.random() - 0.5);
const container = document.getElementById('choices-container');
container.innerHTML = '';
choices.forEach(choice => {
const button = document.createElement('button');
button.className = 'choice-btn';
button.innerText = choice;
button.onclick = () => checkAnswer(button, choice, currentWord.japanese);
container.appendChild(button);
});
}
function checkAnswer(selectedButton, chosenMeaning, correctMeaning) {
if (isAnswered) return;
isAnswered = true;
const container = document.getElementById('choices-container');
const buttons = container.getElementsByClassName('choice-btn');
const feedback = document.getElementById('feedback');
for (let btn of buttons) {
btn.disabled = true;
if (btn.innerText === correctMeaning) {
btn.classList.add('correct');
}
}
if (chosenMeaning === correctMeaning) {
selectedButton.classList.add('correct');
feedback.innerText = "正解だニャ！🎉";
feedback.className = "feedback-message correct";
score++;
} else {
selectedButton.classList.add('incorrect');
feedback.innerText = ザンネン、不正解…😢 正解は「${correctMeaning}」だニャ;
feedback.className = "feedback-message incorrect";
}
document.getElementById('next-btn').style.display = 'block';
}
function nextQuestion() {
currentIndex++;
if (currentIndex < currentQuizWords.length) {
showQuestion();
} else {
showResult();
}
}
function showResult() {
showScreen('result-screen');
document.getElementById('score-text').innerText = ${currentQuizWords.length}問中 ${score}問 正解！;
const rate = score / currentQuizWords.length;
let comment = "";
if (rate === 1) comment = "素晴らしいニャ！満点パーフェクトだニャ！🐾🐱🐾";
else if (rate >= 0.7) comment = "すごいニャ！その調子でがんばるニャ！👍";
else if (rate >= 0.4) comment = "あともう一息ニャ！復習してみるニャ📚";
else comment = "これから一緒に覚えていけば大丈夫ニャ🐾";
document.getElementById('result-comment').innerText = comment;
}
function confirmGoHome() {
if (confirm("ホームに戻ると現在のクイズデータが消えるけど大丈夫かニャ？")) {
goHome();
}
}
function goHome() {
showScreen('home-screen');
}
function showScreen(screenId) {
document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
document.getElementById(screenId).classList.add('active');
}


