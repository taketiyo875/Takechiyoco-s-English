            --error-color: #E74C3C;
        }
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--light-orange);
            color: #333;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .container {
            max-width: 600px;
            width: 100%;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(230, 126, 34, 0.15);
            border: 2px solid var(--primary-orange);
            text-align: center;
            position: relative;
        }
        h1 {
            color: var(--dark-orange);
            margin-bottom: 5px;
        }
        .cat-decoration {
            font-size: 24px;
            margin-bottom: 20px;
        }
        .screen {
            display: none;
        }
        .screen.active {
            display: block;
        }
        .form-group {
            margin: 20px 0;
            text-align: left;
        }
        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            color: var(--dark-orange);
        }
        select, input[type="number"] {
            width: 100%;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 16px;
            box-sizing: border-box;
        }
        select:focus, input[type="number"]:focus {
            border-color: var(--primary-orange);
            outline: none;
        }
        .btn {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s, transform 0.1s;
            width: 100%;
            margin-top: 15px;
        }
        .btn:hover {
            background-color: var(--dark-orange);
        }
        .btn:active {
            transform: scale(0.98);
        }
        .btn-home {
            background-color: #95a5a6;
            margin-top: 20px;
        }
        .btn-home:hover {
            background-color: #7f8c8d;
        }
        .quiz-progress {
            font-size: 14px;
            color: #7f8c8d;
            margin-bottom: 10px;
        }
        .word-display {
            font-size: 32px;
            font-weight: bold;
            color: var(--dark-orange);
            margin: 20px 0;
        }
        .choices-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }
        .choice-btn {
            background-color: var(--primary-orange);
            color: white;
            border: 2px solid var(--primary-orange);
            padding: 15px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            text-align: left;
            font-weight: bold;
            transition: all 0.2s;
        }
        .choice-btn:hover:not(:disabled) {
            background-color: var(--dark-orange);
            border-color: var(--dark-orange);
        }
        .choice-btn.correct {
            background-color: var(--success-color) !important;
            border-color: var(--success-color) !important;
        }
        .choice-btn.incorrect {
            background-color: var(--error-color) !important;
            border-color: var(--error-color) !important;
        }
        .feedback-message {
            font-size: 20px;
            font-weight: bold;
            margin: 15px 0;
            min-height: 30px;
        }
        .feedback-message.correct { color: var(--success-color); }
        .feedback-message.incorrect { color: var(--error-color); }
    </style>
</head>
<body>

<div class="container">
    <h1>英検3級 単語クイズ (1-500)</h1>
    <div class="cat-decoration">🐾 🐱 🐾</div>

    <div id="home-screen" class="screen active">
        <p>レベルと問題数を選んでスタートするニャ！</p>
        <div class="form-group">
            <label for="level-select">レベルを選択：</label>
            <select id="level-select">
                <option value="all">すべて</option>
                <option value="初級">初級</option>
                <option value="中級">中級</option>
                <option value="上級">上級</option>
            </select>
        </div>
        <div class="form-group">
            <label for="question-count">出題問題数：</label>
            <input type="number" id="question-count" min="1" max="500" value="10">
            <small style="color:#7f8c8d;" id="max-info"></small>
        </div>
        <button class="btn" onclick="startQuiz()">クイズスタート 🐾</button>
    </div>

    <div id="quiz-screen" class="screen">
        <div class="quiz-progress" id="progress-text">第 1 問</div>
        <div class="word-display" id="word-text"></div>
        <div class="choices-grid" id="choices-container"></div>
        <div id="feedback" class="feedback-message"></div>
        <button id="next-btn" class="btn" onclick="nextQuestion()" style="display:none;">次の問題へ 🐾</button>
        <button class="btn btn-home" onclick="confirmGoHome()">ホームに戻る 🐱</button>
    </div>

    <div id="result-screen" class="screen">
        <h2>結果発表</h2>
        <div class="word-display" id="score-text"></div>
        <p id="result-comment"></p>
        <button class="btn" onclick="goHome()">もう一度あそぶ 🐾</button>
    </div>
</div>

